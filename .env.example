# ==============================================================================
# SOFTWARE ENGINEERING OPERATING SYSTEM (SE-OS) — CONFIGURAÇÃO DINÂMICA DE PASTAS
# ==============================================================================

# 1. Caminho Absoluto para o seu Cofre do Obsidian (Obsidian Vault)
# No Windows: utilize barras invertidas duplas ou barras normais:
#   Ex: C:/Users/SeuUsuario/Documents/MeuCofreObsidian
# No Linux/macOS:
#   Ex: /home/usuario/meu-cofre-obsidian ou ~/meu-cofre-obsidian
OBSIDIAN_VAULT_PATH=C:/Users/SeuUsuario/Documents/MeuCofreObsidian

# 2. Diretório Raiz Padrão onde seus Projetos de Código Residem
# Permite que você execute `/audit meu-projeto` sem precisar digitar o caminho completo
PROJECTS_ROOT_PATH=C:/Projetos
